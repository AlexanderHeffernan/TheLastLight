#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

run_step() {
  local label="$1"
  shift
  local started_at=$SECONDS

  printf '==> %s\n' "$label"
  "$@"
  printf '<== %s (%ss)\n' "$label" "$((SECONDS - started_at))"
}

run_step "Checking Node.js version" node -e \
  "const [major, minor, patch] = process.versions.node.split('.').map(Number); if (major !== 24 || minor < 22 || (minor === 22 && patch < 1)) { console.error('Node.js 24.22.1 or newer within the Node 24 LTS line is required'); process.exit(1); }"
run_step "Installing locked npm dependencies" npm ci --no-audit --no-fund

printf 'Orb setup complete.\n'
